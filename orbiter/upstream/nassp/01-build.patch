+
+# Native in-tree build uses the engine's SDK and shared library targets.
+if(TARGET OrbiterCore)
+    set(NASSP_SOURCE_ROOT "${CMAKE_CURRENT_SOURCE_DIR}")
+    get_target_property(_sdk_include OrbiterSDKHeaders INTERFACE_INCLUDE_DIRECTORIES)
+    list(GET _sdk_include 0 _sdk_include)
+    get_filename_component(ORBITERSDK_DIR "${_sdk_include}" DIRECTORY)
+    include(cmake/NativeTargets.cmake)
+    if(NOT TARGET PanelSDK)
+        add_subdirectory(Project/PanelSDK)
+    endif()
+    set(NASSP_NATIVE_MODULES "Saturn5;LEM;Sat5LMDSC" CACHE STRING "NASSP modules to build for the native port")
