+    if("LEM" IN_LIST NASSP_NATIVE_MODULES AND NOT "Sat5LMDSC" IN_LIST NASSP_NATIVE_MODULES)
+        list(APPEND NASSP_NATIVE_MODULES Sat5LMDSC)
+    endif()
+    if("Saturn5" IN_LIST NASSP_NATIVE_MODULES AND NOT "ML" IN_LIST NASSP_NATIVE_MODULES)
+        list(APPEND NASSP_NATIVE_MODULES ML)
+    endif()
+    if("Saturn5" IN_LIST NASSP_NATIVE_MODULES AND NOT "Floodlight" IN_LIST NASSP_NATIVE_MODULES)
+        list(APPEND NASSP_NATIVE_MODULES Floodlight)
+    endif()
+    foreach(module IN LISTS NASSP_NATIVE_MODULES)
+        add_subdirectory("Project/${module}")
+    endforeach()
+    if(TARGET LEM AND TARGET Sat5LMDSC)
+        add_dependencies(LEM Sat5LMDSC)
+    endif()
+    if(TARGET Saturn5 AND TARGET LEM AND NOT TARGET ProjectApolloMFD)
+        add_subdirectory(Project/ProjectApolloMFD)
+    endif()
+    return()
+endif()
 
 # Set C++ compiler variables
 set(CMAKE_CXX_STANDARD 17)
