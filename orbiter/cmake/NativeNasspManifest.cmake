# Read upstream source/include manifests; native build policy stays in Orbiter.
include_guard(GLOBAL)

# Upstream's Windows-oriented source lists spell a few filenames differently
# from the files in its repository. Resolve only an exact case-insensitive
# basename match so Linux builds use the original source without editing the
# authoritative manifests or hiding a genuinely missing file.
function(orbiter_resolve_nassp_source_case source output)
  if(EXISTS "${source}")
    set(${output} "${source}" PARENT_SCOPE)
    return()
  endif()
  get_filename_component(directory "${source}" DIRECTORY)
  get_filename_component(requested "${source}" NAME)
  if(NOT IS_DIRECTORY "${directory}")
    message(FATAL_ERROR "NASSP source directory is missing: ${directory}")
  endif()
  string(TOLOWER "${requested}" requested_folded)
  file(GLOB candidates LIST_DIRECTORIES false "${directory}/*")
  set(matches)
  foreach(candidate IN LISTS candidates)
    get_filename_component(name "${candidate}" NAME)
    string(TOLOWER "${name}" name_folded)
    if(name_folded STREQUAL requested_folded)
      list(APPEND matches "${candidate}")
    endif()
  endforeach()
  list(LENGTH matches match_count)
  if(NOT match_count EQUAL 1)
    message(FATAL_ERROR "NASSP source path has ${match_count} case-insensitive matches: ${source}")
  endif()
  set(${output} "${matches}" PARENT_SCOPE)
endfunction()

function(orbiter_read_nassp_manifest module)
  set(manifest "${NASSP_SOURCE_ROOT}/Project/${module}/CMakeLists.txt")
  if(EXISTS "${manifest}")
    file(READ "${manifest}" definition)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    foreach(kind INCLUDE_DIRS SOURCES)
      string(REGEX MATCH "set\\(${kind}[ \t\r\n]+([^)]*)\\)" found "${definition}")
      if(NOT found)
        message(FATAL_ERROR "Unsupported upstream ${module} ${kind} manifest")
      endif()
      string(CONFIGURE "${CMAKE_MATCH_1}" expanded)
      string(REGEX REPLACE "[ \t\r\n]+" ";" expanded "${expanded}")
      list(FILTER expanded EXCLUDE REGEX "^$")
      set(${kind} ${expanded})
    endforeach()
  else()
    # Several lunar experiments have only an upstream Visual Studio manifest.
    set(project_name "${module}")
    if(module STREQUAL "Saturn5")
      set(project_name "Saturn5NASP")
    endif()
    string(TOLOWER "${project_name}" requested)
    file(GLOB projects "${NASSP_SOURCE_ROOT}/Build/VC2017/*.vcxproj")
    # Preserve authoritative upstream XML outside the ignored addon Build tree.
    # Its relative paths still resolve from the original virtual manifest directory.
    if(NOT projects)
      file(GLOB_RECURSE projects "${PROJECT_SOURCE_DIR}/upstream/nassp-manifests/${_native_data_profile}/*.vcxproj")
    endif()
    set(manifest "")
    foreach(project IN LISTS projects)
      get_filename_component(stem "${project}" NAME_WE)
      string(TOLOWER "${stem}" stem)
      if(stem STREQUAL requested)
        set(manifest "${project}")
        break()
      endif()
    endforeach()
    if(NOT manifest)
      message(FATAL_ERROR "No upstream source manifest for ${module}")
    endif()
    file(READ "${manifest}" definition)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${manifest}")
    set(manifest_dir "${NASSP_SOURCE_ROOT}/Build/VC2017")
    string(REGEX MATCHALL "<ClCompile Include=\"[^\"]+\"" source_records "${definition}")
    set(SOURCES)
    foreach(record IN LISTS source_records)
      string(REGEX REPLACE "<ClCompile Include=\"([^\"]+)\"" "\\1" relative "${record}")
      string(REPLACE "\\" "/" relative "${relative}")
      get_filename_component(source "${relative}" ABSOLUTE BASE_DIR "${manifest_dir}")
      list(APPEND SOURCES "${source}")
    endforeach()
    if(NOT SOURCES)
      message(FATAL_ERROR "No sources in upstream ${module} manifest")
    endif()
    string(REGEX MATCH "<AdditionalIncludeDirectories>([^<]+)</AdditionalIncludeDirectories>" found "${definition}")
    set(relative_includes "${CMAKE_MATCH_1}")
    string(REPLACE "%(AdditionalIncludeDirectories)" "" relative_includes "${relative_includes}")
    set(INCLUDE_DIRS)
    foreach(relative IN LISTS relative_includes)
      if(relative)
        string(REPLACE "\\" "/" relative "${relative}")
        get_filename_component(include_dir "${relative}" ABSOLUTE BASE_DIR "${manifest_dir}")
        list(APPEND INCLUDE_DIRS "${include_dir}")
      endif()
    endforeach()
  endif()
  set(resolved_sources)
  foreach(source IN LISTS SOURCES)
    orbiter_resolve_nassp_source_case("${source}" resolved)
    list(APPEND resolved_sources "${resolved}")
  endforeach()
  set(SOURCES ${resolved_sources})
  set(SOURCES ${SOURCES} PARENT_SCOPE)
  set(INCLUDE_DIRS ${INCLUDE_DIRS} PARENT_SCOPE)
endfunction()
